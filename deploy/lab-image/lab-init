#!/bin/sh
# /usr/local/sbin/lab-init
# 실습 컨테이너가 만들어질 때 백엔드가 root 로 한 번 실행한다 (사용자 셸을 붙이기 전).
# 로그 실습에 늘 필요한 것만 켠다. 나머지 서비스(cron, named, vsftpd, apache2)는 실습에서 직접 켠다.

# 시스템 로그 (/var/log/syslog, auth.log, secure, sulog)
service rsyslog start >/dev/null 2>&1 || echo "lab-init: rsyslog 시작 실패" >&2

# 프로세스 accounting (lastcomm, sa). 컨테이너에 CAP_SYS_PACCT 가 있어야 한다 (lab.container.cap-add).
mkdir -p /var/log/account
touch /var/log/account/pacct
chmod 0640 /var/log/account/pacct
accton /var/log/account/pacct >/dev/null 2>&1 || echo "lab-init: 프로세스 accounting 시작 실패 (CAP_SYS_PACCT 확인)" >&2

exit 0
