# ISE-LM1 배포용 Nginx 설정 예시 (/etc/nginx/sites-available/iselm1.conf)
# 프론트엔드 빌드 결과(dist)와 백엔드(127.0.0.1:8080)를 같은 도메인으로 묶는다.
#   - 프론트 빌드: VITE_API_BASE_URL=https://example.com npm run build  → dist/ 를 /var/www/iselm1 로 복사
#   - 백엔드:      lab.cors.allowed-origins=https://example.com
# example.com 을 실제 도메인으로 바꾼다. 인증서는 certbot(Let's Encrypt)으로 발급한다.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name example.com;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;

    # ---- 프론트엔드 (SPA: 없는 경로는 index.html 로) ----
    root /var/www/iselm1;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # ---- WebSocket: /ws/terminal, /ws/capture ----
    # 업그레이드 헤더를 넘기고, 읽기 제한을 실습 세션(10분)보다 길게 둔다.
    # 기본값(60초)이면 입력이 없는 동안 터미널이 끊긴다.
    location /ws/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # ---- SSE: 버퍼링하면 로그가 늦게 도착한다 ----
    location = /api/logs {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # ---- REST ----
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
